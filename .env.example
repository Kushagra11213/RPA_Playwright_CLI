# Copy this file to .env and fill in only a site you are authorized to automate.
# Never commit .env, passwords, session cookies, tokens, or patient information.
#
# The CLI does not load this file on its own. Point it at the secret file when
# you are ready to type credentials:
#   PowerShell: $env:PLAYWRIGHT_MCP_SECRETS_FILE = ".env"
# Then pass the variable name to fill, for example:
#   playwright-cli fill e5 LOGIN_PASSWORD
# The CLI substitutes the value and redacts it from snapshots.

# Site to automate. Leave blank until a real URL is provided.
BASE_URL=

# Authorized account. Do not put real passwords in source files.
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Optional named browser session. Leave blank to use the CLI default session.
PLAYWRIGHT_CLI_SESSION=

# Optional cookies and localStorage saved with `playwright-cli state-save`.
# Keep the file outside git. Do not create it until after an authorized login.
STORAGE_STATE_PATH=artifacts/auth/storage-state.json
